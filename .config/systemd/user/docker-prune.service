[Unit]
Description=Monthly Docker system prune
Documentation=man:docker-system-prune(1)

[Service]
Type=oneshot
# The 14-day filter uses creation time for images, containers, and networks.
# To prune all unused images unconditionally, remove the --filter argument.
ExecStart=/usr/bin/docker system prune -a -f --filter "until=336h"
TimeoutStartSec=30min
