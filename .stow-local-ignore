prv
install.*
bin
docs
tests
.git
.gitignore
.gitmodules
Makefile
^/\.pytest_cache  # local test cache; never stow into $HOME
^/\.nvimlog  # Neovim runtime log; never stow into $HOME
^/\.agy-staff(?:/|$)  # AGY job state; never stow into $HOME
.*\.md
.local
.codex  # stowed separately into ~/.codex (Codex keeps runtime data there)
.opencode  # stowed separately into ~/.opencode (OpenCode keeps runtime data there)
.gemini  # stowed separately into ~/.gemini (Gemini/Antigravity keep runtime data there)
.summarize  # config.json is a seed; Summarize owns and rewrites the runtime copy
# Keep local rclone files left behind by the move to prv/ out of Stow.
^/\.config/rclone(?:/|$)
.config/mise  # linked explicitly for the desktop profile
^/\.config/nvim(?:/|$)  # linked as one static directory by the base installer
^/\.config/btop/btop\.conf  # linked or copied explicitly for the btop version
install.d/  # install helper modules/scripts
.antigravitycli
.ruby-lsp
renovate\.json  # repository automation metadata; never stow into $HOME
