#!/bin/zsh

# Exit immediately if a command exits with a non-zero status,
# if using an undefined variable, or if any command in a pipeline fails.
set -euo pipefail

# Determine the directory where the script is located.
SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
BASE_DIR="$SCRIPT_DIR"
HOME_DIR="$HOME"
CONFIG_DIR="$HOME_DIR/.config"
MISE_BIN="$HOME_DIR/.local/bin/mise"
STOW_APPLY=false

# Source shared helper functions (has, resolve_browser_cmd, etc.)
source "$BASE_DIR/.zsh/helpers.zsh"

# Optional font installer executable that mirrors the Nerd Font helper.
FONT_INSTALLER="$BASE_DIR/install-font"

# Common paths and URLs.
VAULT_URL="https://vault.8567153.xyz/v1/shell_envs/data"
VAULT_KEYS=("envs.zsh")
# Never let a caller-exported Vault token cross child-process boundaries.
typeset -g +x VAULT_TOKEN

# Note: has() and resolve_browser_cmd() are now in .zsh/helpers.zsh

# Function to check if the profile is desktop.
is_desktop() {
  [[ "$DOTFILES_PROFILE" == "desktop" ]]
}

# Function to check if the shell is interactive.
is_interactive() {
  [[ -t 0 ]]
}

# Function to check if stdout is a TTY (for colored output).
is_tty_stdout() {
  [[ -t 1 ]]
}

# Function to print banners for major steps.
print_banner() {
  local title="$1"
  local line="========================================"
  printf "\n%s\n%s\n%s\n" "$line" "$title" "$line"
}

# Initialize ANSI colors (if supported). Respect NO_COLOR.
init_colors() {
  if ! is_tty_stdout; then
    return
  fi
  if [[ -n "${NO_COLOR:-}" ]]; then
    return
  fi

  COLOR_RED=$'\033[31m'
  COLOR_YELLOW=$'\033[33m'
  COLOR_BOLD=$'\033[1m'
  COLOR_RESET=$'\033[0m'
}

# Determine the user's login shell from the passwd database (preferred).
# Falls back to $SHELL if lookup isn't available.
get_login_shell() {
  local user="${USER:-}"
  local shell=""

  if [[ -n "$user" ]] && has "getent"; then
    shell=$(getent passwd "$user" | awk -F: '{print $7}')
  elif [[ -n "$user" ]] && [[ -r /etc/passwd ]]; then
    shell=$(awk -F: -v u="$user" '$1==u{print $7}' /etc/passwd)
  fi

  if [[ -z "$shell" ]]; then
    shell="${SHELL:-}"
  fi

  echo "$shell"
}

# Enforce zsh as the user's login shell unless explicitly overridden.
# This avoids "installation succeeded but nothing changed" when the user stays in bash.
require_zsh_login_shell() {
  if [[ "${DOTFILES_ALLOW_NON_ZSH_SHELL:-0}" == "1" ]]; then
    return
  fi

  local login_shell
  login_shell=$(get_login_shell)

  if [[ -n "$login_shell" ]] && [[ "${login_shell##*/}" == "zsh" ]]; then
    return
  fi

  print_banner "ERROR: Login shell is not zsh"
  printf "%s%s%s\n" "${COLOR_RED:-}" "!!! Aborting install to avoid confusion !!!" "${COLOR_RESET:-}"
  echo ""
  echo "Detected login shell: ${login_shell:-<unknown>}"
  echo ""
  echo "These dotfiles are primarily configured for zsh."
  echo "If you keep using bash, you may not see any changes after installation."
  echo ""
  echo "Fix (recommended):"
  printf "  %schsh -s \"%s\"%s\n" "${COLOR_BOLD:-}" "$(command -v zsh)" "${COLOR_RESET:-}"
  echo "  Then log out and log back in (or reboot)."
  echo ""
  echo "On some systems (e.g. Raspberry Pi OS), you may need:"
  printf "  %ssudo chsh -s \"%s\" \"%s\"%s\n" "${COLOR_BOLD:-}" "$(command -v zsh)" "$USER" "${COLOR_RESET:-}"
  echo ""
  echo "Temporary (current session only):"
  printf "  %sexec zsh -l%s\n" "${COLOR_BOLD:-}" "${COLOR_RESET:-}"
  echo ""
  printf "%sOverride (not recommended):%s\n" "${COLOR_YELLOW:-}" "${COLOR_RESET:-}"
  echo "  DOTFILES_ALLOW_NON_ZSH_SHELL=1 ./install"
  exit 1
}

# Ask once before applying any Stow package during this install run.
configure_stow_apply() {
  if [[ "${DOTFILES_STOW_APPLY:-}" == "1" ]]; then
    STOW_APPLY=true
    return
  fi

  if ! is_interactive; then
    echo "Error: Non-interactive installs require DOTFILES_STOW_APPLY=1." >&2
    return 1
  fi

  print_banner "Stow apply confirmation"
  read -r "response?Apply all dotfiles packages after each successful Stow dry-run? [y/N] "
  if [[ "$response" =~ ^[Yy]$ ]]; then
    STOW_APPLY=true
    return
  fi

  echo "Installation cancelled before applying dotfiles links."
  return 1
}

# Update private data to the gitlink recorded by the desktop checkout.
setup_private_submodule() {
  is_desktop || return 0

  print_banner "Updating private desktop submodule"
  git -C "$BASE_DIR" -c submodule.prv.update=checkout submodule update --init -- prv

  local expected_commit
  local actual_commit
  expected_commit=$(git -C "$BASE_DIR" rev-parse HEAD:prv)
  actual_commit=$(git -C "$BASE_DIR/prv" rev-parse HEAD)
  if [[ "$actual_commit" != "$expected_commit" ]]; then
    echo "Error: prv is at $actual_commit, expected recorded gitlink $expected_commit." >&2
    return 1
  fi
}

# Dry-run every package, then apply under the single installation-wide gate.
install_with_stow() {
  local stow_opts=("$@")

  echo "Running stow with: ${stow_opts[*]}"
  if ! stow -v "${stow_opts[@]}" -n; then
    echo "Error: Stow dry run failed with options: ${stow_opts[*]}" >&2
    return 1
  fi

  [[ "$STOW_APPLY" == "true" ]] || return 1
  echo "Applying changes..."
  stow -v "${stow_opts[@]}"
}

# Function to force-refresh the font cache when fonts are (re)linked.
refresh_font_cache() {
  local font_dir="$HOME_DIR/.local/share/fonts"

  if ! has "fc-cache"; then
    echo "fc-cache not available; cannot refresh font cache." >&2
    exit 1
  fi

  if [[ ! -d "$font_dir" ]]; then
    echo "Font directory $font_dir not found; cannot refresh font cache." >&2
    exit 1
  fi

  print_banner "Refreshing font cache..."
  fc-cache -f "$font_dir"
}

# Function to add secret environment variables from Vault.
add_secret_envs_from_vault() {
  if ! is_interactive; then
    echo "Skipping secret envs setup in non-interactive mode."
    return
  fi

  read -r "response?Would you like to add secret envs from Vault? [y/N] "
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "Skipped adding secret environment variables from Vault."
    return
  fi

  read -rs "VAULT_TOKEN?Please provide your Vault token: "
  echo

  # Ensure restrictive permissions for secrets directory
  (umask 077 && mkdir -p "$HOME_DIR/.zshrc.d")
  chmod 700 "$HOME_DIR/.zshrc.d"

  for key in "${VAULT_KEYS[@]}"; do
    echo "Fetching data for key: $key"

    local vault_response
    vault_response=$(vault_http_get "$VAULT_URL/$key" "$VAULT_TOKEN") || {
      echo "Failed to fetch data for $key from Vault." >&2
      return 1
    }

    local target_file="$HOME_DIR/.zshrc.d/$key"
    echo "# Generated with install script from dotfiles" > "$target_file"
    # Use @sh for safe quoting to prevent injection from special characters
    print -r -- "$vault_response" | jq -er '.data.data | to_entries[] | "export " + .key + "=" + (.value | @sh)' >> "$target_file"
    chmod 600 "$target_file"

    echo "Environment variables for $key have been saved to $target_file"
  done
}

# Function to configure Git conflict style based on git version.
configure_git_conflict_style() {
  local required_git_version="2.35.0"
  local current_version
  current_version=$(git --version | awk '{print $3}')

  autoload -Uz is-at-least
  if is-at-least "$required_git_version" "$current_version"; then
    echo "Git version ($current_version) supports zdiff3."
    git config --file "$HOME_DIR/.gitconfig.local" merge.conflictstyle "zdiff3"
    echo "Set 'merge.conflictstyle' to 'zdiff3' in $HOME_DIR/.gitconfig.local."
  fi
}

# Function to setup Atuin configuration.
setup_atuin() {
  print_banner "Setting up Atuin configuration..."
  mkdir -p "$CONFIG_DIR/atuin/"
  local src="$BASE_DIR/.config/atuin/config.toml"
  local dst="$CONFIG_DIR/atuin/config.toml"

  # Skip if already correctly linked
  if [[ -e "$dst" ]] && [[ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then
    return
  fi

  ln -sfn "$src" "$dst"
}

# Keep runtime-owned parent directories real so Stow cannot fold them into the repo.
prepare_stow_targets() {
  print_banner "Preparing runtime-owned Stow targets..."
  mkdir -p \
    "$CONFIG_DIR/Code/User" \
    "$CONFIG_DIR/atuin" \
    "$CONFIG_DIR/mc" \
    "$HOME_DIR/.ssh/config.d" \
    "$HOME_DIR/.zshrc.d"

  is_desktop || return 0
  mkdir -p "$HOME_DIR/bin" "$HOME_DIR/.var/app"

  local app_dir
  for app_dir in "$BASE_DIR/prv/.var/app"/*(/N); do
    mkdir -p "$HOME_DIR/.var/app/${app_dir:t}"
  done
}

# Remove only dangling links that were created by this repository.
migrate_retired_managed_links() {
  local alacritty_link="$CONFIG_DIR/alacritty"
  local terminal_wrapper_link="$HOME_DIR/bin/my_default_terminal_emulator"
  local podrun_link="$HOME_DIR/bin/podrun"

  if [[ ! -L "$alacritty_link" && ! -L "$terminal_wrapper_link" && ! -L "$podrun_link" ]]; then
    return 0
  fi

  remove_retired_stow_link() {
    local link_path="$1"
    local expected_target="$2"
    local current_target
    local resolved_target

    [[ -L "$link_path" && ! -e "$link_path" ]] || return 0
    current_target=$(readlink "$link_path")
    if [[ "$current_target" == /* ]]; then
      resolved_target="${current_target:a}"
    else
      resolved_target="${link_path:h}/${current_target}"
      resolved_target="${resolved_target:a}"
    fi

    if [[ "$resolved_target" != "$expected_target" ]]; then
      echo "Keeping unmanaged symlink: $link_path -> $current_target"
      return 0
    fi

    rm -f -- "$link_path"
    echo "Removed retired managed symlink: $link_path"
  }

  print_banner "Removing retired managed links"
  remove_retired_stow_link "$alacritty_link" "$BASE_DIR/.config/alacritty"
  remove_retired_stow_link "$terminal_wrapper_link" "$BASE_DIR/bin/my_default_terminal_emulator"
  remove_retired_stow_link "$podrun_link" "$BASE_DIR/bin/podrun"
  unfunction remove_retired_stow_link
}



# Function to install desktop-specific tools via mise.
setup_mise_desktop_tools() {
  print_banner "Setting up mise configuration..."
  local mise_config_dir="$BASE_DIR/.config/mise"
  local local_config="$mise_config_dir/config.local.toml"
  if [[ ! -f "$local_config" ]]; then
    touch "$local_config"
    echo "Created empty local mise config: $local_config"
  fi

  mkdir -p "$CONFIG_DIR/mise"
  local config_file
  local src
  local dst
  for config_file in config.toml config.local.toml; do
    src="$mise_config_dir/$config_file"
    dst="$CONFIG_DIR/mise/$config_file"

    if [[ -e "$dst" ]] && [[ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then
      continue
    fi
    if [[ -e "$dst" || -L "$dst" ]]; then
      echo "Error: refusing to replace unmanaged mise config: $dst" >&2
      return 1
    fi

    ln -s "$src" "$dst"
  done

  if [[ ! -x "$MISE_BIN" ]]; then
    print_banner "Installing mise for the desktop profile..."
    make -C "$BASE_DIR" mise
  fi
  if [[ ! -x "$MISE_BIN" ]]; then
    echo "mise installation did not create an executable at $MISE_BIN." >&2
    return 1
  fi

  print_banner "Installing tools via mise..."
  if ! has "gh" || ! gh auth status --hostname github.com >/dev/null 2>&1; then
    echo "GitHub CLI is unavailable or unauthenticated; GitHub API rate limits may apply."
  fi

  MISE_CONFIG_DIR="$BASE_DIR/.config/mise" "$MISE_BIN" install

  path=("$HOME_DIR/.local/share/mise/shims" "$HOME_DIR/.local/bin" $path)
  typeset -U path
}


# Function to setup rclone configuration from Vault.
setup_rclone() {

  if ! is_interactive; then
    echo "Skipping rclone setup in non-interactive mode."
    return
  fi

  local template="$BASE_DIR/.config/rclone/rclone.conf.template"
  if [[ ! -f "$template" ]]; then
    return
  fi

  read -r "response?Would you like to setup rclone with password from Vault? [y/N] "
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "Skipping rclone config setup."
    return
  fi

  print_banner "Setting up rclone configuration..."

  local rclone_dir="$CONFIG_DIR/rclone"
  local target="$rclone_dir/rclone.conf"
  mkdir -p "$rclone_dir"

  # Use existing VAULT_TOKEN or prompt for one
  if [[ -z "${VAULT_TOKEN:-}" ]]; then
    read -rs "VAULT_TOKEN?Please provide your Vault token: "
    echo
  fi

  # Fetch rclone password from Vault (stored in secret/configs/rclone)
  local vault_url_base="${VAULT_URL%/shell_envs/data}"
  local vault_response
  vault_response=$(vault_http_get "$vault_url_base/secret/data/configs/rclone" "$VAULT_TOKEN") || {
    echo "Failed to fetch rclone secrets from Vault." >&2
    return 1
  }

  local nas_pass
  nas_pass=$(print -r -- "$vault_response" | jq -er '.data.data.nas_pass // empty') || {
    echo "Failed to parse nas_pass from the Vault response." >&2
    return 1
  }

  if [[ -z "$nas_pass" || "$nas_pass" == "null" ]]; then
    echo "nas_pass not found in Vault at secret/configs/rclone." >&2
    return 1
  fi

  # Render the exact password line without treating secret characters as a pattern.
  render_rclone_config() {
    local source_file="$1"
    local output_file="$2"
    local secret="$3"
    local line
    local -i placeholder_count=0

    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == "pass = {{nas_pass}}" ]] && (( ++placeholder_count ))
    done < "$source_file"

    if (( placeholder_count != 1 )); then
      echo "Expected exactly one rclone password placeholder; found $placeholder_count." >&2
      return 1
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == "pass = {{nas_pass}}" ]]; then
        print -r -- "pass = $secret"
      else
        print -r -- "$line"
      fi
    done < "$source_file" > "$output_file"
  }

  if ! (
    local target_tmp=""
    cleanup_rclone_config() {
      [[ -z "$target_tmp" || ! -e "$target_tmp" ]] || rm -f -- "$target_tmp"
    }
    trap cleanup_rclone_config EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    target_tmp=$(mktemp "$rclone_dir/.rclone.conf.XXXXXX")
    chmod 600 "$target_tmp"
    render_rclone_config "$template" "$target_tmp" "$nas_pass"
    mv -f -- "$target_tmp" "$target"
    target_tmp=""
  ); then
    unfunction render_rclone_config
    return 1
  fi
  unfunction render_rclone_config

  echo "rclone config generated at $target"
}

# Function to optionally prepare the Storage Box media SMB automount.
setup_storagebox_media_mount() {

  if ! is_interactive; then
    echo "Skipping Storage Box media mount setup in non-interactive mode."
    return
  fi

  read -r "response?Would you like to setup Storage Box media? [y/N] "
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    echo "Skipping Storage Box media mount setup."
    return
  fi

  local setup_script="$BASE_DIR/prv/bin/setup-storagebox-media-mount"
  if [[ ! -f "$setup_script" || ! -x "$setup_script" ]]; then
    echo "Storage Box setup helper is missing or not executable: $setup_script" >&2
    return 1
  fi

  print_banner "Setting up Storage Box media mount..."
  # Reuse the unexported token over stdin; never expose it in argv or env.
  if [[ -n "${VAULT_TOKEN:-}" ]]; then
    print -r -- "$VAULT_TOKEN" | "$setup_script"
  else
    "$setup_script"
  fi
}

# Function to enable repo-managed user systemd units after stow linked them.
setup_user_systemd_units() {

  local -a enable_units=()
  local -a enable_now_units=()
  local joined_units=""
  local unit=""

  if [[ -f "$CONFIG_DIR/systemd/user/rclone-nas.service" ]] \
    && [[ -f "$CONFIG_DIR/systemd/user/rclone-sleep-handler.service" ]] \
    && [[ -f "$CONFIG_DIR/rclone/rclone.conf" ]]; then
    if [[ ! -d /mnt/nas ]]; then
      echo "Note: /mnt/nas missing. See README.md for first-time setup."
    fi
    enable_units+=(
      "rclone-nas.service"
      "rclone-sleep-handler.service"
    )
  fi

  if [[ -x "$HOME_DIR/bin/daily_briefing/run.sh" ]] \
    && [[ -f "$CONFIG_DIR/systemd/user/daily-briefing.service" ]] \
    && [[ -f "$CONFIG_DIR/systemd/user/daily-briefing.timer" ]]; then
    enable_now_units+=("daily-briefing.timer")
  fi

  if (( ${#enable_units[@]} == 0 )) && (( ${#enable_now_units[@]} == 0 )); then
    return
  fi

  if ! has "systemctl"; then
    echo "systemctl not found; skipping user systemd unit setup."
    return
  fi

  if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "systemd user manager is not available in this session."
    if (( ${#enable_units[@]} )); then
      joined_units="${(j: :)enable_units}"
      echo "Enable these later: systemctl --user daemon-reload && systemctl --user enable $joined_units"
    fi
    if (( ${#enable_now_units[@]} )); then
      joined_units="${(j: :)enable_now_units}"
      echo "Enable these later: systemctl --user daemon-reload && systemctl --user enable --now $joined_units"
    fi
    return
  fi

  print_banner "Enabling user systemd units"
  systemctl --user daemon-reload

  for unit in "${enable_units[@]}"; do
    systemctl --user enable "$unit"
  done

  for unit in "${enable_now_units[@]}"; do
    systemctl --user enable --now "$unit"
  done
}

# Generic helper to set up an AI tool directory via stow.
# Fails early if any subdirectory in the package already exists as a real
# directory in the target (stow would descend into it instead of folding).
setup_ai_tool() {
  local name="$1"
  local target_dir="$2"
  local pkg="$3"
  shift 3
  local extra_args=("$@")

  print_banner "Setting up $name configuration..."
  mkdir -p "$target_dir"

  local repo_pkg="$BASE_DIR/$pkg"
  if [[ -d "$repo_pkg" ]]; then
    local dir
    for dir in "$repo_pkg"/*(/N); do
      local subdir="${dir:t}"
      # Skip subdirectories that match a --ignore pattern (e.g. node_modules)
      local arg skip=false
      for arg in "${extra_args[@]}"; do
        if [[ "$arg" == --ignore=* && "$subdir" =~ ${arg#--ignore=} ]]; then
          skip=true
          break
        fi
      done
      $skip && continue
      if [[ -d "$target_dir/$subdir" ]] && [[ ! -L "$target_dir/$subdir" ]]; then
        echo "ERROR: $target_dir/$subdir already exists as a directory." >&2
        echo "Move or back it up manually, then re-run ./install." >&2
        return 1
      fi
    done
  fi

  install_with_stow -d "$BASE_DIR" -t "$target_dir" "${extra_args[@]}" "$pkg"
}

# Function to setup Codex configuration via stow.
# Uses stow to link .codex contents (scripts) into ~/.codex/.
setup_codex() {
  mkdir -p "$HOME_DIR/.codex/commands"
  setup_ai_tool "Codex" "$HOME_DIR/.codex" ".codex"

  # Stow shared agent commands into ~/.codex/commands/
  install_with_stow -d "$HOME_DIR/.agents" -t "$HOME_DIR/.codex/commands" commands
}

# Function to setup OpenCode configuration via stow.
# Uses stow to link .opencode contents (commands) into ~/.opencode/.
setup_opencode() {
  mkdir -p "$HOME_DIR/.opencode/commands"
  setup_ai_tool "OpenCode" "$HOME_DIR/.opencode" ".opencode" \
    --ignore='node_modules' \
    --ignore='package\.json' \
    --ignore='package-lock\.json' \
    --ignore='bun\.lock'

  # Stow shared agent commands into ~/.opencode/commands/
  install_with_stow -d "$HOME_DIR/.agents" -t "$HOME_DIR/.opencode/commands" commands
}

# Function to setup Antigravity CLI configuration via stow.
# Uses stow to link stable CLI config while leaving runtime data unmanaged.
setup_antigravity_cli() {
  local target_dir="$HOME_DIR/.gemini/antigravity-cli"
  mkdir -p "$target_dir/skills"
  print_banner "Setting up Antigravity CLI configuration..."

  install_with_stow -d "$BASE_DIR/.gemini" -t "$target_dir" "antigravity-cli"

  # Stow shared agent skills into ~/.gemini/antigravity-cli/skills/.
  # Stow does not preserve the package name as a path component, so the
  # target must already include the `skills/` segment.
  install_with_stow -d "$HOME_DIR/.agents" -t "$target_dir/skills" skills
}

# Seed Summarize once while leaving its runtime-written config unmanaged.
setup_summarize() {
  local target_dir="$HOME_DIR/.summarize"
  local config_file="$target_dir/config.json"
  local seed_file="$BASE_DIR/.summarize/config.json"

  print_banner "Setting up Summarize configuration..."
  if [[ -L "$target_dir" || ( -e "$target_dir" && ! -d "$target_dir" ) ]]; then
    echo "ERROR: Summarize runtime directory must be a real directory: $target_dir" >&2
    return 1
  fi
  mkdir -p "$target_dir"

  if [[ ! -f "$seed_file" ]]; then
    echo "ERROR: Summarize config seed is missing: $seed_file" >&2
    return 1
  fi

  install_summarize_seed() (
    local config_tmp=""
    cleanup_summarize_seed() {
      [[ -z "$config_tmp" || ! -e "$config_tmp" ]] || rm -f -- "$config_tmp"
    }
    trap cleanup_summarize_seed EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    config_tmp=$(mktemp "$target_dir/.config.json.XXXXXX")
    command install -m 600 "$seed_file" "$config_tmp"
    mv -f -- "$config_tmp" "$config_file"
    config_tmp=""
  )

  if [[ -L "$config_file" ]]; then
    local linked_file
    linked_file=$(readlink -f "$config_file") || {
      echo "ERROR: Cannot resolve Summarize config link: $config_file" >&2
      unfunction install_summarize_seed
      return 1
    }
    if [[ "$linked_file" != "$(readlink -f "$seed_file")" ]]; then
      echo "ERROR: $config_file points outside this dotfiles repository." >&2
      echo "Move or fix it manually, then re-run ./install." >&2
      unfunction install_summarize_seed
      return 1
    fi

    install_summarize_seed
    unfunction install_summarize_seed
    echo "Replaced the old managed link with a runtime-owned Summarize config."
    return 0
  fi

  if [[ -e "$config_file" ]]; then
    if [[ ! -f "$config_file" ]]; then
      echo "ERROR: Summarize config must be a regular file: $config_file" >&2
      unfunction install_summarize_seed
      return 1
    fi
    echo "Keeping existing runtime-owned Summarize config: $config_file"
    chmod 600 "$config_file"
    unfunction install_summarize_seed
    return 0
  fi

  install_summarize_seed
  unfunction install_summarize_seed
  echo "Seeded runtime-owned Summarize config at $config_file"
}


# Function to setup Vim autoload directories and plugins.
setup_vim() {
  print_banner "Setting up Vim..."
  mkdir -p "$HOME_DIR/.vim/"{autoload,undo,swapfiles,backupfiles}
  curl -fsSLo "$HOME_DIR/.vim/autoload/plug.vim" --create-dirs "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
  vim +PlugInstall +qall
}

# Function to configure installation profile (Desktop vs Server)
configure_profile() {
  local profile_file="$HOME_DIR/.zshrc.d/profile.zsh"
  mkdir -p "$HOME_DIR/.zshrc.d"

  validate_profile() {
    local profile="$1"
    if [[ "$profile" != "desktop" && "$profile" != "server" ]]; then
      echo "Error: Invalid DOTFILES_PROFILE '$profile'. Must be 'desktop' or 'server'." >&2
      return 1
    fi
  }

  # Check if DOTFILES_PROFILE is passed via environment
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    validate_profile "$DOTFILES_PROFILE"

    # Check if the value in the file matches the environment variable to avoid redundant writes
    local current_file_profile=""
    if [[ -f "$profile_file" ]]; then
      # Run in a subshell, unset the env var first to ensure we read what is actually in the file.
      # Without unset, the subshell inherits the exported DOTFILES_PROFILE, masking the file content.
      current_file_profile=$(unset DOTFILES_PROFILE; source "$profile_file" >/dev/null 2>&1 && echo "${DOTFILES_PROFILE:-}")
    fi

    if [[ "$DOTFILES_PROFILE" != "$current_file_profile" ]]; then
      echo "DOTFILES_PROFILE detected in environment: $DOTFILES_PROFILE"
      echo "Saving profile to $profile_file..."
      printf 'export DOTFILES_PROFILE="%s"\n' "$DOTFILES_PROFILE" > "$profile_file"
    else
      echo "Using provided DOTFILES_PROFILE: $DOTFILES_PROFILE (matches existing configuration)"
    fi
    unfunction validate_profile
    return
  fi

  # Load existing profile if available
  if [[ -f "$profile_file" ]]; then
    source "$profile_file"
    validate_profile "${DOTFILES_PROFILE:-}"
  fi

  # Check for non-interactive shell
  if ! is_interactive; then
    if [[ -z "${DOTFILES_PROFILE:-}" ]]; then
      echo "Error: Non-interactive install requires DOTFILES_PROFILE=desktop or DOTFILES_PROFILE=server." >&2
      return 1
    fi
    echo "Non-interactive shell: Using existing profile '$DOTFILES_PROFILE'."
    unfunction validate_profile
    return
  fi

  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    echo "Current profile is: $DOTFILES_PROFILE"
    read -r "response?Do you want to change the profile? [y/N] "
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
      unfunction validate_profile
      return
    fi
  fi

  print_banner "Configuration Profile"
  echo "Select installation profile:"
  echo "1) Desktop (Full installation: GUI tools, fonts, GitHub CLI, etc.)"
  echo "2) Server (Minimal installation: Core tools only)"
  read -r "choice?Enter choice [1/2]: "

  case "$choice" in
    1)
      echo 'export DOTFILES_PROFILE="desktop"' > "$profile_file"
      export DOTFILES_PROFILE="desktop"
      echo "Profile set to Desktop."
      ;;
    2)
      echo 'export DOTFILES_PROFILE="server"' > "$profile_file"
      export DOTFILES_PROFILE="server"
      echo "Profile set to Server."
      ;;
    *)
      echo "Error: Invalid profile choice '$choice'." >&2
      unfunction validate_profile
      return 1
      ;;
  esac
  unfunction validate_profile
}

# Main installation routine that coordinates all tasks.
run_installation() {
  configure_profile

  init_colors
  require_zsh_login_shell
  configure_stow_apply
  setup_private_submodule
  prepare_stow_targets
  migrate_retired_managed_links

  print_banner "Stowing base dotfiles into $HOME_DIR"
  install_with_stow -d "$BASE_DIR" -t "$HOME_DIR" --ignore ".config/atuin/config.toml" --ignore ".gitignore" --ignore "tests" "."

  # Interactive prompts first (before long-running tasks like font cache)
  if is_desktop; then
    print_banner "Secret environment variables from Vault (optional)"
    add_secret_envs_from_vault
    setup_rclone
    setup_storagebox_media_mount
  fi

  print_flatpak_manual_instructions() {
    local -a app_dirs=("$BASE_DIR/prv/.var/app"/*(/N))
    (( ${#app_dirs[@]} == 0 )) && return 0

    if ! has "flatpak"; then
      return 0
    fi

    local global_overrides
    global_overrides=$(flatpak override --user --show)
    local -i remove_global_access=0
    if [[ "$global_overrides" == *"filesystems=~/dotfiles;"* || "$global_overrides" == *"filesystems=$BASE_DIR;"* ]]; then
      if [[ "$global_overrides" != *"!~/dotfiles;"* && "$global_overrides" != *"!$BASE_DIR;"* ]]; then
        remove_global_access=1
      fi
    fi

    local -a app_dirs_missing_access=()
    local app_dir app_id app_overrides
    for app_dir in "${app_dirs[@]}"; do
      app_id="${app_dir:t}"
      app_overrides=$(flatpak override --user --show "$app_id")
      if [[ "$app_overrides" != *"filesystems=$app_dir;"* || "$app_overrides" == *"!$app_dir;"* ]]; then
        app_dirs_missing_access+=("$app_dir")
      fi
    done

    local var_app="$HOME_DIR/.var/app"
    local -a stale_links=()
    local link target
    for link in "$var_app"/**/*(@N); do
      target=$(readlink "$link")
      if [[ "$target" == "$BASE_DIR"* ]]; then
        stale_links+=("$link")
      fi
    done

    (( remove_global_access || ${#app_dirs_missing_access[@]} || ${#stale_links[@]} )) || return 0

    print_banner "Flatpak setup (manual)"
    echo "Flatpak permissions and links are not changed automatically."
    if (( remove_global_access )); then
      echo "To remove the old global dotfiles access, run:"
      printf '  flatpak override --user --nofilesystem=%q\n' "$BASE_DIR"
    fi
    for app_dir in "${app_dirs_missing_access[@]}"; do
      app_id="${app_dir:t}"
      echo "To grant access only to $app_id, run:"
      printf '  flatpak override --user --filesystem=%q %q\n' "${app_dir}:rw" "$app_id"
    done
    for link in "${stale_links[@]}"; do
      echo "If this old managed link blocks stow, remove it with:"
      printf '  rm -f -- %q\n' "$link"
    done
  }

  # Private overrides and fonts after all Y/N prompts (font cache takes time)
  if is_desktop; then
    print_flatpak_manual_instructions
    print_banner "Stowing private overrides from prv/"
    install_with_stow -d "$BASE_DIR/prv" -t "$HOME_DIR" "."

    # Stow user scripts from .local/bin
    if [[ -d "$BASE_DIR/.local/bin" ]]; then
      mkdir -p "$HOME_DIR/.local/bin"
      print_banner "Stowing scripts into $HOME_DIR/.local/bin"
      install_with_stow -t "$HOME_DIR/.local/bin" -d "$BASE_DIR/.local/bin" "."
    fi

    if [[ -d "$BASE_DIR/.local/share/fonts" ]]; then
      mkdir -p "$HOME_DIR/.local/share"
      print_banner "Stowing repository fonts into $HOME_DIR/.local/share"
      install_with_stow -t "$HOME_DIR/.local/share" -d "$BASE_DIR/.local/share" "."
      refresh_font_cache
    fi
  fi

  print_banner "Checking Git conflict style"
  configure_git_conflict_style

  if is_desktop; then
    setup_atuin
    setup_mise_desktop_tools
    setup_codex
    setup_opencode
    setup_antigravity_cli
    setup_summarize

  fi

  local editor_config_file="$HOME_DIR/.zshrc.d/editor.zsh"
  mkdir -p "$HOME_DIR/.zshrc.d"

  local nvim_installed=false
  if has "nvim"; then
    local nvim_version
    nvim_version=$(nvim --version | head -n1 | grep -oE 'v[0-9]+\.[0-9]+' | sed 's/v//')
    autoload -Uz is-at-least
    if is-at-least "0.11" "$nvim_version"; then
      nvim_installed=true

      echo "Configuring Neovim as default editor..."
      cat <<EOF > "$editor_config_file"
# Generated by dotfiles install script
export VISUAL=nvim
export EDITOR=nvim
alias vim='nvim'
EOF
    else
      print_banner "Skipping Neovim setup"
      echo "Neovim version $nvim_version is too old (< 0.11). Using Vim instead."
    fi
  fi

  if [[ "$nvim_installed" == "false" ]]; then
    if has "vim"; then
      setup_vim

      echo "Configuring Vim as default editor..."
      cat <<EOF > "$editor_config_file"
# Generated by dotfiles install script
export VISUAL=vim
export EDITOR=vim
EOF
    fi
  fi

  if is_desktop; then
    setup_terminal_emulator
    setup_kde_terminal_shortcut
    setup_user_systemd_units
  fi

  print_banner "Installation completed successfully."
}

# ==============================================================================
# Desktop & KDE specific setup functions
# ==============================================================================

# Configure KDE Terminal settings and shortcuts if KDE tools are present.
setup_kde_terminal_shortcut() {
  if ! has "kwriteconfig6" && ! has "kwriteconfig5"; then
    echo "KDE configuration tools not found; skipping KDE shortcut setup."
    return 0
  fi

  print_banner "Configuring KDE Terminal settings and shortcuts..."

  local kwriter="kwriteconfig6"
  local kbuildsycoca="kbuildsycoca6"
  local kreader="kreadconfig6"
  if ! has "kwriteconfig6"; then
    kwriter="kwriteconfig5"
    kbuildsycoca="kbuildsycoca5"
    kreader="kreadconfig5"
  fi

  # Prefer Foot, but never leave KDE pointing to the retired wrapper.
  local terminal_application=""
  if has "foot"; then
    terminal_application="foot"
  elif has "alacritty"; then
    terminal_application="alacritty"
  elif has "x-terminal-emulator"; then
    terminal_application="x-terminal-emulator"
  fi

  if [[ -n "$terminal_application" ]]; then
    "$kwriter" --file kdeglobals --group General --key TerminalApplication "$terminal_application"
  elif has "$kreader"; then
    local current_terminal
    current_terminal=$("$kreader" --file kdeglobals --group General --key TerminalApplication --default "")
    if [[ "$current_terminal" == "$HOME_DIR/bin/my_default_terminal_emulator" \
      || "$current_terminal" == "/home/omen/bin/my_default_terminal_emulator" ]]; then
      "$kwriter" --file kdeglobals --group General --key TerminalApplication --delete ""
      echo "Removed the retired KDE terminal wrapper setting; no replacement terminal is installed."
    fi
  else
    echo "No supported terminal or KDE config reader found; keeping the current terminal setting." >&2
  fi

  # The desktop entry intentionally launches Foot directly.
  if [[ "$terminal_application" == "foot" ]]; then
    "$kwriter" --file kglobalshortcutsrc --group "services" --group "my-terminal.desktop" --key "_launch" "Meta+Ins"
  else
    "$kwriter" --file kglobalshortcutsrc --group "services" --group "my-terminal.desktop" --key "_launch" --delete ""
    echo "Disabled Meta+Ins for my-terminal.desktop because Foot is not installed."
  fi

  # Rebuild the system configuration cache.
  if has "$kbuildsycoca"; then
    "$kbuildsycoca" --noincremental >/dev/null 2>&1
  fi

  # Trigger KDE to reload shortcut configurations if DBus is available.
  if has "qdbus"; then
    qdbus org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
    dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:3 int32:5 >/dev/null 2>&1 || true
  fi
}

# Offer to install Foot when it is absent.
setup_terminal_emulator() {
  is_interactive || return 0

  has foot && return 0

  print_banner "Terminal emulator"
  read -r "choice?Foot is not installed. Install foot and foot-terminfo? [y/N] "

  case "$choice" in
    [Yy]*)
      sudo apt-get install -y --no-install-recommends foot foot-terminfo
      ;;
    *)
      echo "Skipping terminal emulator installation."
      ;;
  esac
}

run_installation
