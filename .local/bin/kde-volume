#!/bin/bash
# kde-volume - control PulseAudio/PipeWire sink volume with KDE Plasma OSD feedback

set -euo pipefail

SINK="${1:-}"
ACTION="${2:-}"

# Allow running with single arg for default sink (e.g. kde-volume +5%)
if [[ -z "$ACTION" && -n "$SINK" && "$SINK" =~ ^(\+|\-|[0-9]|toggle|mute) ]]; then
  ACTION="$SINK"
  SINK="@DEFAULT_SINK@"
fi

if [[ -z "$SINK" || -z "$ACTION" ]]; then
  echo "Usage: $0 <sink> <+5%|-5%|toggle>"
  exit 1
fi

# Normalize escaped percent signs (e.g. from KDE .desktop files)
ACTION="${ACTION//%%/%}"
VOLUME_ACTION=""

case "$ACTION" in
  toggle)
    pactl set-sink-mute "$SINK" toggle
    ;;
  +*%|-*%)
    if [[ ! "$ACTION" =~ ^([+-])([0-9]+)%$ ]]; then
      echo "Invalid relative volume: $ACTION" >&2
      exit 1
    fi

    VOLUME_ACTION="${BASH_REMATCH[2]}%${BASH_REMATCH[1]}"
    ;;
  [0-9]*%)
    if [[ ! "$ACTION" =~ ^([0-9]+)%$ ]]; then
      echo "Invalid absolute volume: $ACTION" >&2
      exit 1
    fi

    VOLUME_ACTION="${BASH_REMATCH[1]}%"
    ;;
  *)
    echo "Unknown action: $ACTION" >&2
    exit 1
    ;;
esac

if [[ -n "$VOLUME_ACTION" ]]; then
  SINK_NAME="$SINK"
  [[ "$SINK_NAME" == "@DEFAULT_SINK@" ]] && SINK_NAME=$(pactl get-default-sink)
  SINK_ID=$(pactl list short sinks | awk -v sink="$SINK_NAME" '$2 == sink { print $1; exit }')
  if [[ -z "$SINK_ID" ]]; then
    echo "Sink not found: $SINK" >&2
    exit 1
  fi

  wpctl set-volume --limit 1.0 "$SINK_ID" "$VOLUME_ACTION"
fi

VOL=$(pactl get-sink-volume "$SINK" | grep -oE '[0-9]+%' | head -1 | tr -d '%')
MUTED=$(pactl get-sink-mute "$SINK" | awk '{print $2}')

if [[ "$MUTED" == "yes" ]]; then
  OSD_VOL=0
  ICON="audio-volume-muted"
else
  OSD_VOL="$VOL"
  ICON="audio-volume-high"
fi

LABEL="$SINK"
[[ "$SINK" == "@DEFAULT_SINK@" ]] && LABEL=""

# Trigger KDE Plasma OSD
QDBUS=$(command -v qdbus6 || command -v qdbus || true)
if [[ -n "$QDBUS" ]]; then
  if [[ -n "$LABEL" ]]; then
    "$QDBUS" org.kde.plasmashell /org/kde/osdService org.kde.osdService.mediaPlayerVolumeChanged "$OSD_VOL" "$LABEL" "$ICON" >/dev/null 2>&1 || true
  else
    "$QDBUS" org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged "$OSD_VOL" 100 >/dev/null 2>&1 || true
  fi
fi
