#!/bin/bash
set -euo pipefail

for command_name in summarize jq; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Blad: '$command_name' nie jest zainstalowany." >&2
        exit 1
    fi
done

# Refresh the OpenRouter candidates, then prioritize enabled CLI providers.
summarize refresh-free

CONFIG="$HOME/.summarize/config.json"

if [ -f "$CONFIG" ]; then
    TMP_CONFIG=$(mktemp "${CONFIG}.XXXXXX")
    trap '[[ -z "${TMP_CONFIG:-}" ]] || rm -f -- "$TMP_CONFIG"' EXIT
    trap 'exit 130' HUP INT TERM
    jq '
        (if (.model | type) == "string" then .model
         elif (.model | type) == "object" and (.model.name | type) != "string" and (.model.id | type) == "string" then .model.id
         else "" end | gsub("^\\s+|\\s+$"; "")) as $model |
        (.cli.enabled // [] | map("cli/" + (ascii_downcase | gsub("^\\s+|\\s+$"; ""))) |
         reduce .[] as $cli ([]; if index($cli) then . else . + [$cli] end) |
         map(. as $cli | if $model == $cli or ($model | startswith($cli + "/")) then $model else $cli end)) as $cli |
        .models.free.rules[0].candidates |= ($cli + (. - $cli))
    ' "$CONFIG" > "$TMP_CONFIG"
    mv -fT -- "$TMP_CONFIG" "$CONFIG"
    TMP_CONFIG=""

    echo "Modele odswiezone."
else
    echo "Blad: Nie znaleziono pliku konfiguracyjnego $CONFIG"
    exit 1
fi
